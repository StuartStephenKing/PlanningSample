#region Prolog

ASCIIOutputOpen ( pLogFile, 1 );
ASCIIOutput ( pLogFile, 'Migrating hierarchy: ' | pDimension | ':' | pHierarchy );


vExportDir = 'Migration';
vExportFile     = pDimension | '_' | pHierarchy | '.csv';

DataSourceType          = 'SUBSET';
DatasourceNameForServer = pDimension;
DatasourceCubeview      = 'All';

#endregion
#region Data

ASCIIOutputOpen ( pLogFile, 1 );

vElementParentCount = ElementParentCount ( pDimension, pHierarchy, v1 ); 
IF ( vElementParentCount  > 0);
    vParentIndex = 1;
    WHILE ( vParentIndex <= vElementParentCount );
        vParent = ElementParent ( pDimension, pHierarchy, v1, vParentIndex );
        vElementType = ElementType ( pDimension, pHierarchy, v1 );
        vWeight = ElementWeight ( pDimension, pHierarchy, vParent, v1 );
        ASCIIOUTPUT ( vExportDir | '\' | vExportFile, v1, vParent, NumberToString ( vWeight ), vElementType );
        vParentIndex = vParentIndex + 1;
    END;
ELSE;
    vElementType = ElementType ( pDimension, pHierarchy, v1 );
    ASCIIOUTPUT ( vExportDir | '\' | vExportFile, v1, v1, '0', vElementType );
ENDIF;

#endregion
#region Epilog
# # Authenticate
# vUrl = pTargetURL | '/api/' | pTargetTenant | '/v0/rolemgmt/v1/users/me';
# ExecuteHttpRequest ( 'GET', vUrl, '-h Authorization: basic ' | Base64Encode( 'apikey:' | pTargetAPIKey ) );
# vResponseCode = HttpResponseGetStatusCode();
# vResponseBody  = HttpResponseGetBody();
# IF ( vResponseCode <> 200 );
#     ProcessError();
# ENDIF;

# Import process
vJsonImportProcess = '{
    "Process": {
        "Name":"Migrate.Hierarchy.' | pDimension | '_' | pHierarchy | '",
        "DataProcedure": "",
        "DataSource": {
            "asciiDecimalSeparator": ".",
            "asciiDelimiterChar": ",",
            "asciiDelimiterType": "Character",
            "asciiHeaderRecords": 0,
            "asciiQuoteCharacter": "\"",
            "asciiThousandSeparator": ",",
            "dataSourceNameForServer": "' | pSourceURL | '/api/' | pSourceTenant | '/v0/tm1/' | URLEncode ( pSourceTM1 )  | '/Contents(''Files'')/Contents(''' | vExportDir | ''')/Contents(''' | URLEncode ( '' | vExportFile | '' ) | ''')/Content",
            "Type": "ASCII"
        },
        "EpilogProcedure": "",
        "HasSecurityAccess": false,
        "Parameters": [
            {
                "Name": "pDimension",
                "Prompt": "",
                "Type": "String",
                "Value": "' | pDimension | '"
            },
            {
                "Name": "pHierarchy",
                "Prompt": "",
                "Type": "String",
                "Value": "' | pHierarchy | '"
            }
        ],
       "PrologProcedure": "
                   vPAWBaseUrl = ''' | pSourceURL | '/api/' | pSourceTenant | '/v0'';
                   vUrl = vPAWBaseURL | ''/rolemgmt/v1/users/me'';
                   ExecuteHttpRequest ( ''GET'', vUrl, ''-h Authorization: basic '' | Base64Encode( ''apikey:'' | ''' | pSourceAPIKey | ''' ) );
                   vResponseCode = HttpResponseGetStatusCode();
                   vResponseBody  = HttpResponseGetBody();
                   ASCIIOutput ( ''debug.txt'', NumberToString( vResponseCode ), vResponseBody );
                   IF ( vResponseCode <> 200 );
                       ProcessError();
                    ENDIF;
                   IF ( DimensionExists ( pDimension ) = 1 );
                       IF ( HierarchyExists ( pDimension, pHierarchy) = 1);
                           HierarchyDeleteAllElements ( pDimension, pHierarchy );
                       ELSE;
                           HierarchyCreate ( pDimension, pHierarchy );
                       ENDIF;
                   ELSE;
                       DimensionCreate ( pDimension );
                       IF ( pDimension @<> pHierarchy );
                           HierarchyCreate ( pDimension, pHierarchy );
                        ENDIF;
                   ENDIF;",
       "MetadataProcedure": "
           HierarchyElementInsert ( pDimension, pHierarchy, '''', v1, v4 );
           IF ( v1 @<> v2 );
               HierarchyElementInsert ( pDimension, pHierarchy, '''', v2, v4 );
               HierarchyElementComponentAdd ( pDimension, pHierarchy, v2, v1, v3 );
            ENDIF;",
        "Variables": [
            {
                "Name": "v1",
                "Position": 1,
                "Type": "String"
            },
            {
                "Name": "v2",
                "Position": 2,
                "Type": "String"
            },
            {
                "Name": "v3",
                "Position": 3,
                "Type": "Numeric"
            },
            {
                "Name": "v4",
                "Position": 4,
                "Type": "String"
            }
        ]
    }
}'; 

# POST Extract process to remote database
vRemoteDatabaseProcessesUrl = pTargetURL | '/api/' | pTargetTenant | '/v0/tm1/' | URLEncode ( pTargetTM1 ) | '/api/v1/' | 'ExecuteProcessWithReturn?$expand=*';

IF ( pDebug @= 'Y' );
    #ASCIIOUTPUT ( pLogFile, 'POST ' | vRemoteDatabaseProcessesUrl );
    #ASCIIOutput ( pLogFile, vJsonImportProcess );
ENDIF;
ExecuteHttpRequest ( 'POST', vRemoteDatabaseProcessesUrl,  '-k', '-h Content-Type:application/json',  '-d ' |  vJsonImportProcess );
vResponseCode = HttpResponseGetStatusCode();
vResponseBody = HttpResponseGetBody();
IF ( pDebug @= 'Y' );
    #ASCIIOUTPUT ( pLogFile, NumberToString ( vResponseCode ) | ' ' | vResponseBody );
ENDIF;
IF ( vResponseCode < 200 % vResponseCode >= 300 );
    ProcessQuit;
ENDIF;

IF ( SCAN ( 'QuitCalled', vResponseBody) > 0);
    ProcessQuit;
ENDIF;


#endregion