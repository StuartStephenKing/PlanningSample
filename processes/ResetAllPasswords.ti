#region Prolog

vClientIndex = 1;
vClient = ElementName ( '}Clients', '}Clients', vClientIndex );
WHILE ( vClient @<> '' );
    AssignClientPassword ( vClient, 'apple' );


    vClientIndex = vClientIndex + 1;
    vClient = ElementName ( '}Clients', '}Clients', vClientIndex );
END;


#endregion