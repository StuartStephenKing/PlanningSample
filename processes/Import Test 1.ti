#region Prolog
MinorErrorLogMax = -1;
OnMinorErrorDoItemSkip = 1;
If (CubeExists('PA DC Expense') = 0);
If (DimensionExists('Product') = 0);
DimensionCreate('Product');
EndIf;
If (DimensionExists('Customer') = 0);
DimensionCreate('Customer');
EndIf;
If (DimensionExists('Calendar') = 0);
DimensionCreate('Calendar');
EndIf;
If (DimensionExists('Location') = 0);
DimensionCreate('Location');
EndIf;
CubeCreate('PA DC Expense','Product','Customer','Calendar','Location');
EndIf;
NumMetaRowsRead = 0;
NumMetaRowsProcessed = 0;
NumRowsRead = 0;
NumRowsProcessed = 0;
SetInputCharacterSet('TM1CS_UTF8');
lastAttr='';
iAttr=DIMSIZ('}ElementAttributes_Customer');
i=iAttr;
While(i > 0);
attrName = DIMNM('}ElementAttributes_Customer', i);
If(SUBST(attrName,0,1)@<>'}');
lastAttr=attrName;
i=0;
Else;
i=i-1;
EndIf;
End;
ElementAttrInsert('Customer','Customer',lastAttr,'Customer name','S');
lastAttr = 'Customer name';
lastAttr='';
iAttr=DIMSIZ('}ElementAttributes_Location');
i=iAttr;
While(i > 0);
attrName = DIMNM('}ElementAttributes_Location', i);
If(SUBST(attrName,0,1)@<>'}');
lastAttr=attrName;
i=0;
Else;
i=i-1;
EndIf;
End;
ElementAttrInsert('Location','Location',lastAttr,'Long','S');
lastAttr = 'Long';
ElementAttrInsert('Location','Location',lastAttr,'Lat','S');
lastAttr = 'Lat';

#endregion
#region Metadata
NumMetaRowsRead = NumMetaRowsRead + 1;
vLastMember='';
If(Usage_Sub_Group@<>'');
If(vLastMember@='');
HierarchyElementInsert('Product','Product','',Usage_Sub_Group,'N');
Else;
If(HierarchyElementExists('Product','Leaves',Usage_Sub_Group)=1);
StringToNumber('IMPERROR_CL_'|Usage_Sub_Group);
EndIf;
HierarchyElementInsert('Product','Product','',Usage_Sub_Group,'C');
HierarchyElementComponentAdd('Product','Product',Usage_Sub_Group,vLastMember,1.0);
EndIf;
vLastMember=Usage_Sub_Group;
EndIf;
If(Usage@<>'');
If(vLastMember@='');
HierarchyElementInsert('Product','Product','',Usage,'N');
Else;
If(HierarchyElementExists('Product','Leaves',Usage)=1);
StringToNumber('IMPERROR_CL_'|Usage);
EndIf;
HierarchyElementInsert('Product','Product','',Usage,'C');
HierarchyElementComponentAdd('Product','Product',Usage,vLastMember,1.0);
EndIf;
vLastMember=Usage;
EndIf;
If(Offering@<>'');
If(vLastMember@='');
HierarchyElementInsert('Product','Product','',Offering,'N');
Else;
If(HierarchyElementExists('Product','Leaves',Offering)=1);
StringToNumber('IMPERROR_CL_'|Offering);
EndIf;
HierarchyElementInsert('Product','Product','',Offering,'C');
HierarchyElementComponentAdd('Product','Product',Offering,vLastMember,1.0);
EndIf;
vLastMember=Offering;
EndIf;
If(Customer_Number@<>'');
HierarchyElementInsert('Customer','Customer','',Customer_Number,'N');
EndIf;
vLastMember='';
If(vMonth@<>'');
If(vLastMember@='');
HierarchyElementInsert('Calendar','Calendar','',vMonth,'N');
Else;
If(HierarchyElementExists('Calendar','Leaves',vMonth)=1);
StringToNumber('IMPERROR_CL_'|vMonth);
EndIf;
HierarchyElementInsert('Calendar','Calendar','',vMonth,'C');
HierarchyElementComponentAdd('Calendar','Calendar',vMonth,vLastMember,1.0);
EndIf;
vLastMember=vMonth;
EndIf;
If(Quarter@<>'');
If(vLastMember@='');
HierarchyElementInsert('Calendar','Calendar','',Quarter,'N');
Else;
If(HierarchyElementExists('Calendar','Leaves',Quarter)=1);
StringToNumber('IMPERROR_CL_'|Quarter);
EndIf;
HierarchyElementInsert('Calendar','Calendar','',Quarter,'C');
HierarchyElementComponentAdd('Calendar','Calendar',Quarter,vLastMember,1.0);
EndIf;
vLastMember=Quarter;
EndIf;
If(vYear@<>'');
If(vLastMember@='');
HierarchyElementInsert('Calendar','Calendar','',vYear,'N');
Else;
If(HierarchyElementExists('Calendar','Leaves',vYear)=1);
StringToNumber('IMPERROR_CL_'|vYear);
EndIf;
HierarchyElementInsert('Calendar','Calendar','',vYear,'C');
HierarchyElementComponentAdd('Calendar','Calendar',vYear,vLastMember,1.0);
EndIf;
vLastMember=vYear;
EndIf;
vLastMember='';
If(Data_Centre@<>'');
If(vLastMember@='');
HierarchyElementInsert('Location','Location','',Data_Centre,'N');
Else;
If(HierarchyElementExists('Location','Leaves',Data_Centre)=1);
StringToNumber('IMPERROR_CL_'|Data_Centre);
EndIf;
HierarchyElementInsert('Location','Location','',Data_Centre,'C');
HierarchyElementComponentAdd('Location','Location',Data_Centre,vLastMember,1.0);
EndIf;
vLastMember=Data_Centre;
EndIf;
If(Location@<>'');
If(vLastMember@='');
HierarchyElementInsert('Location','Location','',Location,'N');
Else;
If(HierarchyElementExists('Location','Leaves',Location)=1);
StringToNumber('IMPERROR_CL_'|Location);
EndIf;
HierarchyElementInsert('Location','Location','',Location,'C');
HierarchyElementComponentAdd('Location','Location',Location,vLastMember,1.0);
EndIf;
vLastMember=Location;
EndIf;
If(Country@<>'');
If(vLastMember@='');
HierarchyElementInsert('Location','Location','',Country,'N');
Else;
If(HierarchyElementExists('Location','Leaves',Country)=1);
StringToNumber('IMPERROR_CL_'|Country);
EndIf;
HierarchyElementInsert('Location','Location','',Country,'C');
HierarchyElementComponentAdd('Location','Location',Country,vLastMember,1.0);
EndIf;
vLastMember=Country;
EndIf;
If(Region@<>'');
If(vLastMember@='');
HierarchyElementInsert('Location','Location','',Region,'N');
Else;
If(HierarchyElementExists('Location','Leaves',Region)=1);
StringToNumber('IMPERROR_CL_'|Region);
EndIf;
HierarchyElementInsert('Location','Location','',Region,'C');
HierarchyElementComponentAdd('Location','Location',Region,vLastMember,1.0);
EndIf;
vLastMember=Region;
EndIf;
NumMetaRowsProcessed = NumMetaRowsProcessed + 1;

#endregion
#region Data
NumRowsRead = NumRowsRead + 1;
If (Usage_Sub_Group @<> '' & Customer_Number @<> '' & vMonth @<> '' & Data_Centre @<> '' & Cost @<> '');
CellPutN(StringToNumberEx(Cost,'.',','),'PA DC Expense',Usage_Sub_Group,Customer_Number,vMonth,Data_Centre);
NumRowsProcessed = NumRowsProcessed + 1;
EndIf;
If (Customer_Number @<> '');
ElementAttrPutS(Customer,'Customer','Customer',Customer_Number,'Customer name');
EndIf;
If (Data_Centre @<> '');
ElementAttrPutS(Longitude,'Location','Location',Data_Centre,'Long');
EndIf;
If (Data_Centre @<> '');
ElementAttrPutS(Lattitude,'Location','Location',Data_Centre,'Lat');
EndIf;

#endregion
#region Epilog
If (pResult @<> '');
TextOutput(pResult, NumberToString(NumRowsRead), NumberToString(NumRowsProcessed), NumberToString(NumMetaRowsRead), NumberToString(NumMetaRowsProcessed));
EndIf;

#endregion