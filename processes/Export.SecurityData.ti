#region Prolog

vExportFile = '^/' | pFile;
vView       = '__Export';

vMDX = 'SELECT { [}Groups].[}Groups].MEMBERS } ON 0, 
   { ' | pObjectSet | ' } ON 1 
FROM
   [' | pCube | ']';

ViewCreateByMDX( pCube, vView, vMDX, 1 );

DataSourceType='VIEW';
DatasourceNameForServer=pCube;
DatasourceCubeview=vView;

ViewExtractSkipCalcsSet ( pCube, vView, 1 );
ViewExtractSkipRuleValuesSet ( pCube, vView, 1 );
ViewExtractSkipZeroesSet ( pCube, vView, 1 );

#endregion
#region Data

ASCIIOUTPUT ( vExportFile, v1, v2, v3 );

#endregion
#region Epilog


#endregion