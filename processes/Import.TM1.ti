#region Prolog

vProcessName = GetProcessName ();
vNow         = TIMST ( NOW (), '\Y\m\d\h\i\s' );
vLogFile     = '/Process logs/' | vProcessName | '_' | vNow | '.log';
ASCIIOutputOpen ( vLogFile, 1 );

# Authenticate
vSourcePAURL = pTargetURL | '/api/' | pTargetTenant | '/v0';
vUrl = vSourcePAURL | '/rolemgmt/v1/users/me';
ExecuteHttpRequest ( 'GET', vUrl, '-h Authorization: basic ' | Base64Encode( 'apikey:' | pTargetAPIKey ) );
vResponseCode = HttpResponseGetStatusCode();
vResponseBody  = HttpResponseGetBody();
IF ( vResponseCode < 200 % vResponseCode >= 300 );
    ProcessError();
ENDIF;

# Check if EnableSandboxDimension is enabled
vEnableSandboxDimensionUrl = vSourcePAURL | '/tm1/' | URLEncode ( pTargetTM1 ) | '/api/v1/ActiveConfiguration/Administration/EnableSandboxDimension';
ExecuteHttpRequest ( 'GET', vEnableSandboxDimensionUrl,  '-k' );
vResponseCode = HttpResponseGetStatusCode();
vResponseBody = HttpResponseGetBody();
IF ( pDebug @= 'Y' );
    #ASCIIOUTPUT ( pLogFile, NumberToString ( vResponseCode ) | ' ' | vResponseBody );
ENDIF;
# IF ( vResponseCode <> 204 );
#     ProcessError;
# ENDIF;
vSandboxDimensionEnabled = JsonToString ( vResponseBody, 'value' );
ASCIIOutput ( vLogFile, 'Sandbox dimension is ' | vSandboxDimensionEnabled );



# Processes

vDir = pImportDir | '/Cubes';
vFile = WildcardFileSearch ( vDir |'/*', '' );
vLastFile = vFile;
WHILE ( vFile @<> '' );
    #ASCIIDelete ( vDir | '/' | vFile );
    vFile = WildcardFileSearch (  vDir |'/*', '' );
    IF (vLastFile @= vFile);
        ASCIIOutput ( 'Cubes.txt', vFile );
        #ExecuteProcess ( 'GIT.Delete Directory', 'pDeleteDir', vDir | '/' | vFile );
    ENDIF;
    vLastFile = vFile;
END;
#ASCIIDelete ( vDir );


