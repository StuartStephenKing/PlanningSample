#region Prolog

vDimension = 'Dimension1';
vSubset = '_temp';
SubsetCreate ( vDimension, vSubset, 1 );

vElementIndex = 1;
vElement = DIMNM ( vDimension, vElementIndex );
WHILE ( vElement @= '' );
    SubsetElementInsert ( vDimension, vSubset, vElement, vElementIndex );

    vElementIndex = vElementIndex + 1;
    vElement = DIMNM ( vDimension, vElementIndex );

END;



Sleep ( 1000000 );
#endregion