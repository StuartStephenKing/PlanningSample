#region Prolog

ASCIIOutputOpen ( pLogFile, 1 );
ASCIIOutput ( pLogFile, 'Migrating subsets from hierarchy: ' | pDimension | ':' | pHierarchy );

# Process configuration
vTargetPAURL  = pTargetURL | '/api/' | pTargetTenant | '/v0';
vSourcePAURL = pSourceURL | '/api/' | pSourceTenant | '/v0';

vSubsetIndex = 1;
vSubset = ElementName ( '}Subsets_' | pDimension, '}Subsets_' | pHierarchy, vSubsetIndex );
WHILE ( vSubset @<> '' );
    #Read the local process
    vProcessURL = vSourcePAURL | '/tm1/' | URLEncode ( pSourceTM1 ) | '/api/v1/Dimensions(''' | URLEncode ( pDimension ) | ''')' | '/Hierarchies(''' | URLEncode ( pHierarchy ) | ''')' | '/Subsets(''' | URLEncode ( vSubset ) | ''')?$expand=Elements($select=Name)';
    ExecuteHttpRequest ( 'GET', vProcessURL, '-k', '-h Content-Type:application/json' );
    vResponseCode = HttpResponseGetStatusCode();
    vResponseBody = HttpResponseGetBody();
    IF ( pDebug @= 'Y' );
        #ASCIIOUTPUT ( vLogFile, NumberToString ( vResponseCode ) | ' ' | vResponseBody );
    ENDIF;
    IF ( vResponseCode <> 200 );
        ASCIIOutput ( pLogFile, 'Migrating subset from hierarchy: ' | pDimension | ':' | pHierarchy | ' failed' );
        ProcessError();
    ENDIF;

    # Modify the susbet JSON
    vSubsetJSON = vResponseBody;
    vSubsetJSON = JsonRemove  ( vSubsetJSON, '@odata.context' );
    vSubsetJSON = JsonRemove (  vSubsetJSON, '@odata.etag' );

    vExpression = JsonToString ( vSubsetJSON, 'Expression' );
    IF ( vExpression @= 'null' );
        vSubsetJSON = JsonRemove (  vSubsetJSON, 'Expression' );

        vSourceSubsetElementsJSONArray = JsonGet ( vSubsetJSON, 'Elements' );
        vTargetSubsetElementsJSONArray = '[]';
        vSourceSubsetElementsIndex = 0;
        WHILE ( vSourceSubsetElementsIndex < JsonSize ( vSourceSubsetElementsJSONArray ) );
            vSourceSubsetElementJson = JsonGet ( vSourceSubsetElementsJSONArray, vSourceSubsetElementsIndex );
            vSourceSubsetElement = JsonToString ( vSourceSubsetElementJson, 'Name' );
            vTargetSubsetElementsJSONArray = JsonAdd ( vTargetSubsetElementsJSONArray, vSourceSubsetElementsIndex, StringToJson ( 'Dimensions(''' | pDimension | ''')/Hierarchies(''' | pHierarchy | ''')/Elements(''' | vSourceSubsetElement | ''')' ) );
            vSourceSubsetElementsIndex = vSourceSubsetElementsIndex + 1;
        END;
        vSubsetJSON = JsonAdd ( vSubsetJSON, 'Elements@odata.bind', JsonToString ( vTargetSubsetElementsJSONArray ) );
    ENDIF;
    
    vSubsetJSON = JsonRemove (  vSubsetJSON, 'Elements' );
    
    # Add the subset  on the  remote database
    vRemoteDatabaseProcessesUrl = vTargetPAURL | '/tm1/' | URLEncode ( pTargetTM1 ) | '/api/v1/Dimensions(''' | URLEncode ( pDimension ) | ''')' | '/Hierarchies(''' | URLEncode ( pHierarchy ) | ''')' | '/Subsets';
    IF ( pDebug @= 'Y' );
        #ASCIIOUTPUT ( vLogFile, 'POST ' | vRemoteDatabaseProcessesUrl );
        #ASCIIOUTPUT ( vLogFile, 'BODY ' | vSubsetJSON );
    ENDIF;
    ExecuteHttpRequest ( 'POST', vRemoteDatabaseProcessesUrl,  '-k', '-h Content-Type:application/json',  '-d ' | vSubsetJSON );
    vResponseCode = HttpResponseGetStatusCode();
    vResponseBody = HttpResponseGetBody();
    IF ( pDebug @= 'Y' );
        #ASCIIOUTPUT ( vLogFile, NumberToString ( vResponseCode ) | ' ' | vResponseBody );
    ENDIF;

    IF ( vResponseCode = 400 );
        jsonErrorResponse = JsonGet ( vResponseBody, 'error' );
        jsonErrorCode = JsonGet ( jsonErrorResponse, 'code' );
        IF ( StringToNumber ( JsonToString ( jsonErrorCode ) ) = 278 & pReplace @= 'Y' );
            vRemoteDatabaseProcessesUrl = vTargetPAURL | '/tm1/' | URLEncode ( pTargetTM1 ) | '/api/v1/' |  URLEncode ( 'Dimensions(''' | URLEncode ( pDimension ) | ''')' ) | '/' | URLEncode ( 'Hierarchies(''' | URLEncode ( pHierarchy ) | ''')' ) | '/' |  '/' | URLEncode ( 'Subsets(''' | URLEncode ( vSubset ) | ''')' );
            vSubsetJSON = JsonRemove ( vSubsetJSON, 'Name' );
            ExecuteHttpRequest ( 'PATCH', vRemoteDatabaseProcessesUrl,  '-k', '-h Content-Type:application/json',  '-d ' |  vSubsetJSON );
            vResponseCode = HttpResponseGetStatusCode();
            vResponseBody = HttpResponseGetBody();
            IF ( pDebug @= 'Y' );
                #ASCIIOUTPUT ( vLogFile, NumberToString ( vResponseCode ) | ' ' | vResponseBody );
            ENDIF;
            IF ( vResponseCode <> 200 );
                ASCIIOutput ( pLogFile, 'Error migrating subset: ' | vSubset );
            ENDIF;
        ENDIF;
    ELSEIF ( vResponseCode <> 201 );
        ASCIIOutput ( pLogFile, 'Error migrating subset: ' | vSubset );
    ELSE; 
        ASCIIOutput ( pLogFile, 'Subset: ' | vSubset | ' migration complete'  );
    ENDIF;

    vSubsetIndex = vSubsetIndex + 1;
    vSubset = ElementName ( '}Subsets_' | pDimension, '}Subsets_' | pHierarchy, vSubsetIndex );
END;



#endregion